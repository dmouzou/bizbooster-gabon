rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Annonces : images uniquement (B5: get public mais list interdit)
    match /ads/{userId}/{allPaths=**} {
      allow get: if true;
      allow list: if false;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.contentType.matches('image/.*')
                   && request.resource.size < 10 * 1024 * 1024;
    }

    // Vidéos descriptives d'annonces (B5: get public mais list interdit)
    match /videos/{userId}/{allPaths=**} {
      allow get: if true;
      allow list: if false;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.contentType.matches('video/.*')
                   && request.resource.size < 50 * 1024 * 1024;
    }

    // CVs et documents professionnels (B5: accès restreint au propriétaire et aux admins, list interdit)
    match /cvs/{userId}/{allPaths=**} {
      allow get: if request.auth != null && (
        request.auth.uid == userId ||
        ('role' in request.auth.token && (request.auth.token.role == 'ADMIN' || request.auth.token.role == 'SUPER_ADMIN'))
      );
      allow list: if false;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && (request.resource.contentType == 'application/pdf'
                       || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
                       || request.resource.contentType == 'application/msword'
                       || request.resource.contentType == 'text/markdown'
                       || request.resource.contentType == 'text/plain')
                   && request.resource.size < 15 * 1024 * 1024;
    }

    // Documents KYC d'identité (accès restreint au propriétaire et aux admins, list interdit)
    match /kyc/{userId}/{allPaths=**} {
      allow get: if request.auth != null && (
        request.auth.uid == userId ||
        ('role' in request.auth.token && (request.auth.token.role == 'ADMIN' || request.auth.token.role == 'SUPER_ADMIN'))
      );
      allow list: if false;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf')
                   && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
