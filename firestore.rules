rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Super Admin = custom claim OR users/{uid}.role in ['SUPER_ADMIN', 'SUPER ADMIN']
    function isSuperAdmin() {
      return isSignedIn() && (
        ('role' in request.auth.token && (request.auth.token.role == 'SUPER_ADMIN' || request.auth.token.role == 'SUPER ADMIN')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'USER') == 'SUPER_ADMIN' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'USER') == 'SUPER ADMIN'))
      );
    }

    // Admin = custom claim OR users/{uid}.role in ['ADMIN', 'SUPER_ADMIN', 'SUPER ADMIN']
    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        ('role' in request.auth.token && request.auth.token.role == 'ADMIN') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'USER') == 'ADMIN' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'USER') == 'SUPER_ADMIN'))
      );
    }

    // Champs privilégiés d'un utilisateur (gérés exclusivement par le serveur ou admin)
    function privilegedKeys() {
      return [
        'isAdmin',
        'isSuperAdmin',
        'isExempt',
        'exemptFromPaymentAndKyc',
        'subscriptionTier',
        'subscriptionExpiresAt',
        'subscriptionStartedAt',
        'freeBoostsRemaining',
        'consumedFreeAdsCount',
        'activeBoosterPack',
        'activePack',
        'idVerifiedAt',
        'password',
        'lastPasswordChangeDate'
      ];
    }

    // Clés de classement, de paiement, de quota et de modération (Phase 1)
    function rankingKeys() {
      return [
        'isFeatured',
        'featuredUntil',
        'featuredAt',
        'ownerTier',
        'isOwnerVip',
        'isOwnerVerified',
        'isVipCorner',
        'paidAmount',
        'paymentMethod',
        'transactionRef',
        'paymentVerified',
        'viewsCount',
        'reportsCount',
        'pendingExtension',
        'suspensionReason',
        'suspendedAt',
        'lastExtendedAt'
      ];
    }

    // Champs sensibles d'une annonce qu'un propriétaire ne peut modifier arbitrairement
    function touchesProtectedAdFields() {
      return (
        request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'publishedAt',
          'expiresAt',
          'moderatedAt',
          'moderationReason',
          'userId'
        ]) || (
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          && request.resource.data.status != 'PENDING_REVIEW'
        )
      );
    }

    // ---------------------------------------------------------------
    // ADS (Phase 1 : protection stricte du classement et du statut)
    // ---------------------------------------------------------------
    match /ads/{adId} {

      // Lecture publique : uniquement annonces ACTIVE, ou propriétaire de l'annonce, ou admin
      allow read: if resource.data.status == 'ACTIVE'
                  || (isSignedIn() && resource.data.userId == request.auth.uid)
                  || isAdmin();

      // Création : utilisateur connecté, statut impérativement PENDING_REVIEW,
      // aucune clé de rankingKeys() présente (paymentReference est autorisée pour vérification serveur)
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'PENDING_REVIEW'
                    && !request.resource.data.keys().hasAny(rankingKeys());

      // Mise à jour :
      // - Admin complet
      // - Propriétaire : userId inchangé, aucune modification sur rankingKeys(),
      //   statut modifiable uniquement vers PENDING_REVIEW, champs protégés intacts
      // - Signalement de fraude : incrément atomique unitaire de reportsCount (limité)
      allow update: if isAdmin()
                    || (isSignedIn()
                        && resource.data.userId == request.auth.uid
                        && request.resource.data.userId == request.auth.uid
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(rankingKeys())
                        && !touchesProtectedAdFields())
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportsCount'])
                        && request.resource.data.reportsCount == resource.data.reportsCount + 1);

      // Suppression : Admin ou propriétaire
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ---------------------------------------------------------------
    // USERS
    // ---------------------------------------------------------------
    match /users/{userId} {

      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
                    && request.resource.data.role == 'USER'
                    && !request.resource.data.keys().hasAny(privilegedKeys());

      allow update: if isSuperAdmin()
                    || (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['isExempt', 'exemptFromPaymentAndKyc', 'role', 'subscriptionTier',
                                 'subscriptionExpiresAt', 'freeBoostsRemaining']))
                    || (isOwner(userId)
                        && request.resource.data.get('role', 'USER') == resource.data.get('role', 'USER')
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(privilegedKeys())
                        && (request.resource.data.get('idVerificationStatus', 'NOT_SUBMITTED') != 'VERIFIED'
                            || resource.data.get('idVerificationStatus', 'NOT_SUBMITTED') == 'VERIFIED'));

      allow delete: if isSuperAdmin();
    }

    // ---------------------------------------------------------------
    // FRAUD REPORTS
    // ---------------------------------------------------------------
    match /reports/{reportId} {
      allow create: if request.resource.data.adId is string
                    && request.resource.data.reason is string;

      allow read, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // MODERATION LOGS (admin only)
    // ---------------------------------------------------------------
    match /moderation_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // SYSTEM COUNTERS (lecture publique, écriture admin/serveur)
    // ---------------------------------------------------------------
    match /system_counters/{counterId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // SETTINGS (public_config lisible par tous, system_config réservé aux admins)
    // ---------------------------------------------------------------
    match /settings/{settingId} {
      allow read: if settingId == 'public_config'
                  || (settingId == 'system_config' && isAdmin())
                  || (settingId == 'payment_gateway' && isSuperAdmin())
                  || (settingId != 'system_config' && settingId != 'payment_gateway');
      allow write: if settingId == 'payment_gateway' ? isSuperAdmin() : isAdmin();
    }

    // ---------------------------------------------------------------
    // USER NOTIFICATIONS (Restreint à l'utilisateur ciblé ou admin)
    // ---------------------------------------------------------------
    match /user_notifications/{notifId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ---------------------------------------------------------------
    // PAYMENTS (Lecture propriétaire/admin, écritures client strictement interdites)
    // ---------------------------------------------------------------
    match /payments/{paymentId} {
      allow read: if isAdmin()
                  || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid));
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // AD VIEWS (Dédoublonnage des vues par tranche de 24h, Cloud Function registerView)
    // ---------------------------------------------------------------
    match /ad_views/{viewId} {
      allow read, write: if isAdmin();
    }
  }
}
