rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Super Admin = custom claim d'abord (zéro get() facturé), sinon repli document users/{uid}.role
    function isSuperAdmin() {
      return isSignedIn() && (
        ('role' in request.auth.token && (request.auth.token.role == 'SUPER_ADMIN' || request.auth.token.role == 'SUPER ADMIN')) ||
        (!('role' in request.auth.token) &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'USER') == 'SUPER_ADMIN' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'USER') == 'SUPER ADMIN'))
      );
    }

    // Admin = custom claim d'abord (zéro get() facturé), sinon repli document users/{uid}.role
    function isAdmin() {
      return isSignedIn() && (
        ('role' in request.auth.token && (request.auth.token.role == 'ADMIN' || request.auth.token.role == 'SUPER_ADMIN' || request.auth.token.role == 'SUPER ADMIN')) ||
        (!('role' in request.auth.token) &&
         (isSuperAdmin() ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'USER') == 'ADMIN')))
      );
    }

    // Champs privilégiés d'un utilisateur (gérés exclusivement par le serveur ou admin)
    function privilegedKeys() {
      return [
        'isAdmin',
        'isSuperAdmin',
        'isExempt',
        'exemptFromPaymentAndKyc',
        'subscriptionTier',
        'subscriptionExpiresAt',
        'subscriptionStartedAt',
        'freeBoostsRemaining',
        'freeBoosts',
        'consumedFreeAdsCount',
        'activeBoosterPack',
        'activePack',
        'idVerifiedAt'
      ];
    }

    // Clés de classement, de paiement, de quota et de modération (Phase 1 & Lot 1)
    function rankingKeys() {
      return [
        'isFeatured',
        'featuredUntil',
        'featuredAt',
        'featuredPausedAt',
        'boostRequested',
        'withBoost',
        'ownerTier',
        'isOwnerVip',
        'isOwnerVerified',
        'isVipCorner',
        'paidAmount',
        'paymentMethod',
        'transactionRef',
        'paymentVerified',
        'viewsCount',
        'reportsCount',
        'pendingExtension',
        'suspensionReason',
        'suspendedAt',
        'lastExtendedAt'
      ];
    }

    // Clés verrouillées pour le propriétaire d'une annonce (Phase 7.1 & Lot 1)
    function ownerLockedKeys() {
      return [
        'durationDays',
        'boostRequested',
        'withBoost',
        'featuredPausedAt',
        'paymentReference',
        'paidAmount',
        'isFeatured',
        'featuredAt',
        'featuredUntil',
        'expiresAt',
        'status'
      ];
    }

    // Champs sensibles d'une annonce qu'un propriétaire ne peut modifier arbitrairement
    function touchesProtectedAdFields() {
      return (
        request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'publishedAt',
          'expiresAt',
          'moderatedAt',
          'moderationReason',
          'userId'
        ])
      );
    }

    // ---------------------------------------------------------------
    // ADS (Phase 7 & Lot 1 : protection stricte des annonces contre tout contournement)
    // ---------------------------------------------------------------
    match /ads/{adId} {

      // Lecture publique : uniquement annonces ACTIVE, ou propriétaire de l'annonce, ou admin
      allow read: if resource.data.status == 'ACTIVE'
                  || (isSignedIn() && resource.data.userId == request.auth.uid)
                  || isAdmin();

      // Création : utilisateur connecté, propriétaire légitime,
      // statut initial en attente uniquement, pas de mise en avant, pas d'échéance ni de publication fournies,
      // limites de taille sur les champs et prix >= 0
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && (request.resource.data.status == 'PENDING_REVIEW' || request.resource.data.status == 'PENDING_PAYMENT')
                    && !request.resource.data.keys().hasAny(['publishedAt', 'expiresAt', 'moderatedAt', 'moderationReason'])
                    && !request.resource.data.keys().hasAny(rankingKeys())
                    && request.resource.data.title is string && request.resource.data.title.size() <= 120
                    && request.resource.data.get('description', '').size() <= 4000
                    && request.resource.data.get('price', 0) is number && request.resource.data.get('price', 0) >= 0;

      // Mise à jour :
      // - Admin complet
      // - Propriétaire : userId inchangé, annonce obligatoirement en attente (une annonce ACTIVE ne peut être modifiée directement sans resubmitAd),
      //   aucune modification sur ownerLockedKeys(), rankingKeys() ou champs protégés
      allow update: if isAdmin()
                    || (isSignedIn()
                        && resource.data.userId == request.auth.uid
                        && request.resource.data.userId == request.auth.uid
                        && resource.data.status in ['PENDING_REVIEW', 'PENDING_PAYMENT']
                        && request.resource.data.status in ['PENDING_REVIEW', 'PENDING_PAYMENT']
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(ownerLockedKeys())
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(rankingKeys())
                        && !touchesProtectedAdFields());

      // Suppression : Admin ou propriétaire
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    function adminAllowedUserKeys() {
      return [
        'idVerificationStatus',
        'idVerifiedAt',
        'idRejectionReason',
        'isKycVerified',
        'isVerified',
        'updatedAt'
      ];
    }

    // ---------------------------------------------------------------
    // USERS
    // ---------------------------------------------------------------
    match /users/{userId} {

      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
                    && request.resource.data.role == 'USER'
                    && !request.resource.data.keys().hasAny(privilegedKeys())
                    && !request.resource.data.keys().hasAny(['isKycVerified', 'isVerified', 'password', 'lastPasswordChangeDate'])
                    && request.resource.data.get('idVerificationStatus', 'NOT_SUBMITTED') in ['NOT_SUBMITTED', 'PENDING'];

      allow update: if isSuperAdmin()
                    || (isAdmin() && request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(adminAllowedUserKeys()))
                    || (isOwner(userId)
                        && request.resource.data.get('role', 'USER') == resource.data.get('role', 'USER')
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(privilegedKeys())
                        && !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['isKycVerified', 'isVerified', 'isAdmin', 'isSuperAdmin', 'password', 'lastPasswordChangeDate'])
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['idVerificationStatus'])
                            || request.resource.data.idVerificationStatus in ['NOT_SUBMITTED', 'PENDING'])
                        && (resource.data.get('idVerificationStatus', 'NOT_SUBMITTED') != 'VERIFIED'
                            || request.resource.data.diff(resource.data).affectedKeys().hasAny(['idDocumentUrl']))
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['idDocumentUrl'])
                            || request.resource.data.get('idVerificationStatus', 'NOT_SUBMITTED') == 'PENDING')
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['phone'])
                            || request.resource.data.phone == resource.data.get('phone', '')));

      allow delete: if isSuperAdmin();
    }

    // ---------------------------------------------------------------
    // FRAUD REPORTS
    // ---------------------------------------------------------------
    match /reports/{reportId} {
      allow create: if isSignedIn()
                    && reportId == request.resource.data.adId + '_' + request.auth.uid
                    && request.resource.data.keys().hasOnly(['adId', 'reason', 'details', 'reporterId', 'reporterPhone', 'status', 'createdAt'])
                    && request.resource.data.status == 'PENDING'
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.reason is string && request.resource.data.reason.size() <= 200
                    && request.resource.data.get('details', '').size() <= 2000;

      allow read, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // MODERATION LOGS (admin only)
    // ---------------------------------------------------------------
    match /moderation_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // écrit par les Cloud Functions
    }

    // ---------------------------------------------------------------
    // SYSTEM COUNTERS (super admin uniquement)
    // ---------------------------------------------------------------
    match /system_counters/{counterId} {
      allow read, write: if isSuperAdmin();
    }

    // ---------------------------------------------------------------
    // SETTINGS (liste blanche stricte : public_config lisible par tous, system_config super-admin only en écriture)
    // ---------------------------------------------------------------
    match /settings/{settingId} {
      allow read: if settingId == 'public_config' || (settingId == 'system_config' && isAdmin());
      allow write: if (settingId == 'public_config' && isAdmin())
                   || (settingId == 'system_config' && isSuperAdmin());
    }

    // ---------------------------------------------------------------
    // CONFIG PRIVEE & AUDIT PASSERELLE (Annexe A)
    // ---------------------------------------------------------------
    match /private_config/{id} {
      allow read, write: if false;
    }

    match /gateway_audit/{id} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // USER NOTIFICATIONS (Système/admin en écriture, lu et acquitté par le propriétaire)
    // ---------------------------------------------------------------
    match /user_notifications/{notifId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if (isAdmin() && request.resource.data.userId is string)
                    || (isSignedIn()
                        && request.resource.data.userId == request.auth.uid
                        && notifId == request.auth.uid + '_' + request.resource.data.get('notifId', ''));
      allow update: if isAdmin()
                    || (isSignedIn()
                        && resource.data.userId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']));
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // PAYMENTS (Lecture propriétaire/admin, écritures client strictement interdites)
    // ---------------------------------------------------------------
    match /payments/{paymentId} {
      allow read: if isAdmin()
                  || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid));
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // AD VIEWS (Dédoublonnage des vues par tranche de 24h, Cloud Function registerView)
    // ---------------------------------------------------------------
    match /ad_views/{viewId} {
      allow read, write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // AD COUNTERS (Compteurs de vues répartis, C-03 / O-08)
    // ---------------------------------------------------------------
    match /ad_counters/{adId} {
      allow read: if true;
      allow write: if false; // écrit exclusivement par la Cloud Function registerView
    }
  }
}
