rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Super Admin = custom claim OR users/{uid}.role in ['SUPER_ADMIN', 'SUPER ADMIN']
    function isSuperAdmin() {
      return isSignedIn() && (
        ('role' in request.auth.token && (request.auth.token.role == 'SUPER_ADMIN' || request.auth.token.role == 'SUPER ADMIN')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'USER') == 'SUPER_ADMIN' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'USER') == 'SUPER ADMIN'))
      );
    }

    // Admin = custom claim OR users/{uid}.role in ['ADMIN', 'SUPER_ADMIN', 'SUPER ADMIN'].
    // L'accès admin vient uniquement du rôle ou des custom claims.
    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        ('role' in request.auth.token && request.auth.token.role == 'ADMIN') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'USER') == 'ADMIN' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'USER') == 'SUPER_ADMIN'))
      );
    }

    // Champs privilégiés qu'un utilisateur ne peut jamais écrire (Section 5.1)
    function privilegedKeys() {
      return [
        'isAdmin',
        'isSuperAdmin',
        'isExempt',
        'exemptFromPaymentAndKyc',
        'subscriptionTier',
        'subscriptionExpiresAt',
        'subscriptionStartedAt',
        'freeBoostsRemaining',
        'activeBoosterPack',
        'activePack',
        'idVerifiedAt',
        'password'
      ];
    }

    // Fields an advertiser must never change on their own ad arbitrarily.
    // They may only transition status to PENDING_REVIEW (e.g. when editing an active or pending ad for re-verification).
    function touchesProtectedAdFields() {
      return (
        request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'publishedAt',
          'expiresAt',
          'moderatedAt',
          'moderationReason',
          'paymentVerified'
        ]) || (
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          && !(request.resource.data.status in ['PENDING_REVIEW', 'SUSPENDED', 'ACTIVE'])
        )
      );
    }

    // ---------------------------------------------------------------
    // ADS (Section 5.2)
    // ---------------------------------------------------------------
    match /ads/{adId} {

      // Public: read any ad (active ads in catalog, advertiser checking their own ad, etc.)
      allow read: if true;

      // Create: strictly signed in advertiser owning their ad
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;

      // Update: Admin, Owner (without touching protected fields), or atomic increments
      allow update: if isAdmin()
                    || (isSignedIn() && resource.data.userId == request.auth.uid && !touchesProtectedAdFields())
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount'])
                        && request.resource.data.viewsCount == resource.data.viewsCount + 1)
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportsCount'])
                        && request.resource.data.reportsCount == resource.data.reportsCount + 1);

      // Delete: Admin or Owner
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ---------------------------------------------------------------
    // USERS (Section 5.1)
    // ---------------------------------------------------------------
    match /users/{userId} {

      allow read: if isOwner(userId) || isAdmin();

      // Création : uniquement par le propriétaire, rôle USER, aucune clé privilégiée
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'USER'
                    && !request.resource.data.keys().hasAny(privilegedKeys());

      // Mise à jour :
      // - Super Admin a tous les droits
      // - Admin peut valider KYC mais ne peut toucher ni aux exemptions, rôle, abonnements
      // - Propriétaire ne peut pas modifier les clés privilégiées ni s'auto-promouvoir
      allow update: if isSuperAdmin()
                    || (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['isExempt', 'exemptFromPaymentAndKyc', 'role', 'subscriptionTier',
                                 'subscriptionExpiresAt', 'freeBoostsRemaining']))
                    || (isOwner(userId)
                        && request.resource.data.get('role', 'USER') == resource.data.get('role', 'USER')
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(privilegedKeys())
                        && (request.resource.data.get('idVerificationStatus', 'NOT_SUBMITTED') != 'VERIFIED'
                            || resource.data.get('idVerificationStatus', 'NOT_SUBMITTED') == 'VERIFIED'));

      allow delete: if isSuperAdmin();
    }

    // ---------------------------------------------------------------
    // FRAUD REPORTS
    // ---------------------------------------------------------------
    match /reports/{reportId} {
      allow create: if request.resource.data.adId is string
                    && request.resource.data.reason is string;

      allow read, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // MODERATION LOGS (admin only)
    // ---------------------------------------------------------------
    match /moderation_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // SYSTEM COUNTERS (Section 5.2 : écriture admin/serveur uniquement)
    // ---------------------------------------------------------------
    match /system_counters/{counterId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // SYSTEM SETTINGS (Section 5.2 : écriture réservée aux admins)
    // ---------------------------------------------------------------
    match /settings/{settingId} {
      allow read: if settingId == 'payment_gateway' ? isSuperAdmin() : true;
      allow write: if settingId == 'payment_gateway' ? isSuperAdmin() : isAdmin();
    }

    // ---------------------------------------------------------------
    // USER NOTIFICATIONS (Tracking notification history & anti-duplicate)
    // ---------------------------------------------------------------
    match /user_notifications/{notifId} {
      allow read, write: if isSignedIn() || isAdmin();
    }

    // ---------------------------------------------------------------
    // PAYMENTS (Section 5.2 : lecture propriétaire/admin, écritures client refusées)
    // ---------------------------------------------------------------
    match /payments/{paymentId} {
      allow read: if isAdmin()
                  || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid));
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // Everything else is denied by default.
    // ---------------------------------------------------------------
  }
}
